# ==========================================
# TASVIR AI STUDIO — ENVIRONMENT VARIABLES TEMPLATE
# ==========================================

# 1. Database Connection (PostgreSQL / Neon)
DATABASE_URL=postgresql://user:password@ep-host.us-east-2.aws.neon.tech/neondb?sslmode=require

# 2. Server Ports & Security
PORT=4000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# 3. Cloudflare Turnstile Bot Protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFdvkOhmRvnl6lUT
TURNSTILE_SECRET_KEY=0x4AAAAAAFdvkDC021HoBq0VPu3HTgzFuP4

# 4. Google OAuth 2.0 Single Sign-On
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# 5. Google Gemini AI & Video Generator
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_PROJECT_NAME=tasvirAI

# 6. UploadThing Cloud Storage (Permanent Video Storage)
UPLOADTHING_TOKEN="YOUR_UPLOADTHING_TOKEN_HERE"

# 7. Admin Token Management & Security (Only Admin Can Issue Tokens)
ADMIN_SECRET_KEY=your_secure_admin_secret_key_here
